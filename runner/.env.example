# Your own keys. aeo-index reads them from the environment, or from this file
# only when you pass --env-file. An engine with no key is not asked.
# ChatGPT (OpenAI API key)
OPENAI_API_KEY=
# Claude, and the default judge (Anthropic API key)
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio API key)
GEMINI_API_KEY=
# Gemini, read when GEMINI_API_KEY is not set
GOOGLE_API_KEY=
# Grok (xAI API key)
XAI_API_KEY=
# Grok, read when XAI_API_KEY is not set
GROK_API_KEY=
# Perplexity (Perplexity API key)
PERPLEXITY_API_KEY=
# Google AI Overview, results page via DataForSEO: asked only when both are set
DATAFORSEO_LOGIN=
# Google AI Overview, results page via DataForSEO: the password for the login above
DATAFORSEO_PASSWORD=
